# Unity writes a space after the colon for empty YAML fields in the development project.
Development~/Sandbox/**/*.asset whitespace=-blank-at-eol,cr-at-eol
Development~/Sandbox/**/*.mat whitespace=-blank-at-eol,cr-at-eol
Development~/Sandbox/**/*.meta whitespace=-blank-at-eol,cr-at-eol
Development~/Sandbox/**/*.prefab whitespace=-blank-at-eol,cr-at-eol
